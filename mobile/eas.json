{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "corepack": true,
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "corepack": true,
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.kiliccoffeeroaster.com.tr",
        "EXPO_PUBLIC_SHOP_URL": "https://kiliccoffeeroaster.com.tr"
      }
    },
    "production": {
      "corepack": true,
      "autoIncrement": true,
      "android": { "buildType": "app-bundle" },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.kiliccoffeeroaster.com.tr",
        "EXPO_PUBLIC_SHOP_URL": "https://kiliccoffeeroaster.com.tr"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
