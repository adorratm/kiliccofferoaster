{
  "expo": {
    "name": "Kılıç Coffee Roaster",
    "slug": "kilic-ops",
    "version": "1.0.0",
    "description": "Torbalı / İzmir specialty kahve: fiziksel kavrum siparişi, kargo veya mağazadan teslim, sipariş takibi ve hesap. Ödeme harici ödeme sağlayıcısı ile yapılır; dijital abonelik yoktur.",
    "orientation": "portrait",
    "scheme": "kilicops",
    "userInterfaceStyle": "dark",
    "icon": "./assets/icon.png",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "enabled": true,
      "url": "https://u.expo.dev/5e3e5653-794f-49ef-baf6-e32edbd29340",
      "checkAutomatically": "NEVER",
      "fallbackToCacheTimeout": 0
    },
    "plugins": [
      "expo-dev-client",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#131313"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#cc5b3e",
          "defaultChannel": "default"
        }
      ],
      "expo-updates",
      "expo-secure-store",
      "expo-apple-authentication",
      [
        "expo-image-picker",
        {
          "photosPermission": "Personel ürün kataloğuna görsel yüklemek için galeri erişimi gerekir. Müşteri alışverişinde kullanılmaz.",
          "cameraPermission": false
        }
      ]
    ],
    "ios": {
      "supportsTablet": true,
      "usesAppleSignIn": true,
      "bundleIdentifier": "tr.kiliccoffeeroaster.ops",
      "associatedDomains": [
        "applinks:kiliccoffeeroaster.com.tr",
        "applinks:www.kiliccoffeeroaster.com.tr"
      ],
      "icon": "./assets/icon.png",
      "infoPlist": {
        "NSUserNotificationsUsageDescription": "Sipariş durumu ve kampanya bildirimleri için kullanılır.",
        "NSPhotoLibraryUsageDescription": "Personel ürün kataloğuna görsel yüklemek için galeri erişimi gerekir. Müşteri alışverişinde kullanılmaz.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "tr.kiliccoffeeroaster.ops",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#131313"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": false,
          "data": [
            {
              "scheme": "kilicops"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        },
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "kiliccoffeeroaster.com.tr",
              "pathPrefix": "/"
            },
            {
              "scheme": "https",
              "host": "www.kiliccoffeeroaster.com.tr",
              "pathPrefix": "/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "owner": "adorratm",
    "extra": {
      "eas": {
        "projectId": "5e3e5653-794f-49ef-baf6-e32edbd29340"
      },
      "privacyPolicyUrl": "https://kiliccoffeeroaster.com.tr/gizlilik",
      "supportUrl": "https://kiliccoffeeroaster.com.tr/iletisim"
    }
  }
}