{
  "expo": {
    "name": "Kılıç Coffee Roaster",
    "slug": "kilic-ops",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "kilicops",
    "userInterfaceStyle": "dark",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#131313"
    },
    "plugins": [
      "expo-dev-client",
      "expo-font",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#cc5b3e",
          "defaultChannel": "default"
        }
      ],
      "expo-secure-store"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "tr.kiliccoffeeroaster.ops",
      "icon": "./assets/icon.png",
      "infoPlist": {
        "NSUserNotificationsUsageDescription": "Sipariş ve kampanya bildirimleri için kullanılır.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "tr.kiliccoffeeroaster.ops",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#131313"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": false,
          "data": [
            {
              "scheme": "kilicops",
              "host": "auth",
              "pathPrefix": "/callback"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "5e3e5653-794f-49ef-baf6-e32edbd29340"
      }
    },
    "owner": "adorratm"
  }
}
