    "js-yaml@npm:5.2.1": "5.2.3",
    "js-yaml@npm:5.2.2": "5.2.3",
    "brace-expansion": "patch:brace-expansion@npm%3A5.0.9#~/.yarn/patches/brace-expansion-npm-5.0.9-2717df6b49.patch",
    "react-native": "0.79.5",
    "metro": "0.82.5",
